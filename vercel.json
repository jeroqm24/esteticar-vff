{
  "rewrites": [
    { "source": "/api/ig-auth",     "destination": "/api/instagram?action=auth" },
    { "source": "/api/ig-callback", "destination": "/api/instagram?action=callback" },
    { "source": "/api/ig-refresh",  "destination": "/api/instagram?action=refresh" },
    { "source": "/(.*)",            "destination": "/index.html" }
  ],
  "crons": [
    {
      "path": "/api/reminders",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/resubscribe",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/remarketing",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/remarketing",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/remarketing",
      "schedule": "30 22 * * *"
    },
    {
      "path": "/api/remarketing",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/instagram?action=refresh",
      "schedule": "0 8 1 * *"
    }
  ]
}
